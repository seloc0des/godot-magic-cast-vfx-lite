; Engine configuration file.
config_version=5

[application]

config/name="Magic Cast VFX — Lite"
config/description="Free rune-circle spell-cast effect for Godot 4."
run/main_scene="res://demo/dragdrop_example.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/magic_cast_vfx_lite/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
